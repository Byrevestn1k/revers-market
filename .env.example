NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/navpaky
POSTGRES_DB=navpaky
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Email verification (SMTP required in production)
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional SMS gateway webhook receiving {"to":"+380...","code":"1234"}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Publish a lone agreement review after this many days (both reviews publish immediately).
REVIEW_BLIND_DAYS=14
