{
    "name": "@navpaky/backend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "db:migrate": "tsx src/db/migrate.ts",
